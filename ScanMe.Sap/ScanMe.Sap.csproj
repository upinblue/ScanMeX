<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NAPS2</RootNamespace>
    <Title>ScanMe.Sap</Title>
    <Product>ScanMe.Sap</Product>
    <Description>SAP ArchiveLink configuration models for ScanMe.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!--
    SAP .NET Connector (NCo) is SAP-licensed/proprietary. Configure a private package source and build with
    /p:EnableSapNco=true to restore these packages for runtime RFC connectivity.
  -->
  <ItemGroup Condition="'$(EnableSapNco)' == 'true'">
    <PackageReference Include="sapnco" Version="[3.1.0,4.0.0)" />
    <PackageReference Include="sapnco_utils" Version="[3.1.0,4.0.0)" />
  </ItemGroup>

</Project>
