<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="ScanMe"
      Language="1033"
      Version="{{ !version }}"
      Manufacturer="ScanMe Software"
      UpgradeCode="FEB82971-B3E6-4F19-9684-1D543E644D73">
    <!-- TODO: Files aren't updated if the version isn't bumped. How to fix? I guess it doesn't matter for verification if we delete the folder preemptively... -->
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
    <Media Id="1" Cabinet="NAPS2.cab" EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="icon.ico" SourceFile="NAPS2.Lib\Icons\favicon.ico"/>
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />

    <!-- Windows Installer only compares the first three fields of the version, so 1.0.0.1 -> 1.0.0.2
         would otherwise not be detected as an upgrade and the two would install side by side.
         AllowSameVersionUpgrades makes those replace the existing installation instead. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit." />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="NAPS2.Setup\license.rtf" />

    <Feature Id="MainApplication" Title="ScanMe" Level="1">
      <ComponentRef Id="Exec" />
      <ComponentRef Id="Deps" />
      <ComponentRef Id="DepsWin32" />
      <ComponentRef Id="DepsWin64" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="RegistryEntries" />
      <ComponentGroupRef Id="LangComponents" />
    </Feature>

    <Property Id="INNOINSTALLATION" Value="NOTEXIST">
      <DirectorySearch Id="CheckFileDir" Path="[ProgramFiles64Folder]NAPS2" Depth="0">
        <FileSearch Id="CheckFile" Name="unins000.exe" />
      </DirectorySearch>
    </Property>

    <Condition Message="ScanMe has already been installed using the EXE installer and can't be upgraded using the MSI installer. Either use the EXE installer to upgrade, or uninstall ScanMe then re-install with the MSI.">
        <![CDATA[INNOINSTALLATION="NOTEXIST"]]>
    </Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ScanMe">
          <Directory Id="LIBFOLDER" Name="lib">
            <Directory Id="LIBWIN32FOLDER" Name="_win32" />
            <Directory Id="LIBWIN64FOLDER" Name="_win64" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="ScanMe" />
      </Directory>
      <Directory Id="SystemFolder" />

      <!-- Registry -->
      <Component Id="RegistryEntries" Guid="B97335A8-9481-4E4E-8F1C-486758F5259D">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\WIA_{1c3a7177-f3a7-439e-be47-e304a185f932}">
          <RegistryValue Type="string" Name="Action" Value="Scan with ScanMe" />
          <RegistryValue Type="string" Name="CLSID" Value="WIACLSID" />
          <RegistryValue Type="string" Name="DefaultIcon" Value="sti.dll,0" />
          <RegistryValue Type="string" Name="InitCmdLine" Value="/WiaCmd;[INSTALLFOLDER]ScanMe.exe /StiDevice:%1 /StiEvent:%2;" />
          <RegistryValue Type="string" Name="Provider" Value="ScanMe" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\StillImage\Registered Applications">
          <RegistryValue Type="string" Name="ScanMe" Value="[INSTALLFOLDER]ScanMe.exe" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\StillImage\Events\STIProxyEvent\{1c3a7177-f3a7-439e-be47-e304a185f932}">
          <RegistryValue Type="string" Name="Cmdline" Value="[INSTALLFOLDER]ScanMe.exe /StiDevice:%1 /StiEvent:%2" />
          <RegistryValue Type="string" Name="Desc" Value="Scan with ScanMe" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLFOLDER]ScanMe.exe,0" />
          <RegistryValue Type="string" Name="Name" Value="ScanMe" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".pdf\OpenWithProgids">
          <RegistryValue Type="string" Name="ScanMe" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".jpg\OpenWithProgids">
          <RegistryValue Type="string" Name="ScanMe" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".jpeg\OpenWithProgids">
          <RegistryValue Type="string" Name="ScanMe" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".png\OpenWithProgids">
          <RegistryValue Type="string" Name="ScanMe" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".tiff\OpenWithProgids">
          <RegistryValue Type="string" Name="ScanMe" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".tif\OpenWithProgids">
          <RegistryValue Type="string" Name="ScanMe" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".bmp\OpenWithProgids">
          <RegistryValue Type="string" Name="ScanMe" Value="" />
        </RegistryKey>
        <!-- The ProgID the OpenWithProgids entries above name is "ScanMe", so its icon and open command
             have to hang off HKCR\ScanMe. They were left under HKCR\NAPS2 by the rebranding, which gave
             the registered ProgID no open command at all: ScanMe appeared in Explorer's "Open with" list
             and then did nothing when picked. -->
        <RegistryKey Root="HKCR" Key="ScanMe">
          <RegistryValue Type="string" Value="ScanMe" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="ScanMe\DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]ScanMe.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="ScanMe\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]ScanMe.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
      </Component>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="Exec" Guid="B4093C7A-F808-41F8-90FF-D7FD92D50D59">
        <!-- !root -->
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="LIBFOLDER">
      <Component Id="Deps" Guid="4035DF7E-BD1D-4DFD-B2F0-AD53F0B5C789">
        <!-- !lib -->
      </Component>
    </DirectoryRef>

    <!-- Platform-specific dependencies -->
    <DirectoryRef Id="LIBWIN32FOLDER">
      <Component Id="DepsWin32" Guid="62327E92-9CE1-4CBE-A009-18FB3951953C">
        <!-- !win32 -->
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="LIBWIN64FOLDER">
      <Component Id="DepsWin64" Guid="12E0B652-D60F-4B45-9D36-6F5B2C42403B">
        <!-- !win64 -->
      </Component>
    </DirectoryRef>

    <!-- The Start menu entry. What makes it actually appear is the component GUID being ScanMe's own.
         It used to be the one upstream NAPS2 ships, and Windows Installer reference-counts components by
         GUID across products: on a machine that has (or once had) NAPS2 installed, that component was
         already registered against NAPS2's own Start menu folder, so installing ScanMe found it "already
         installed" and created no shortcut at all. Every other component in this file carried an
         inherited GUID for the same reason; they are all ScanMe's now.

         The key path stays under HKCU and is not a choice: ICE38 and ICE43 treat ProgramMenuFolder as
         user-profile data and fail the build outright for a component that keeps a non-advertised
         shortcut there with a per-machine key path. The key itself is ScanMe's own rather than NAPS2's,
         because sharing that too is part of what made this component indistinguishable from NAPS2's. -->
    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="ApplicationShortcut" Guid="110CA516-7570-41D4-90E8-8F2568FBCEA9">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="ScanMe"
                  Description="ScanMe"
                  Target="[INSTALLFOLDER]ScanMe.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="icon.ico"
                  IconIndex="0" />
        <RemoveFolder Id="ProgramMenuDir" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\ScanMe" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="LangComponents">
      <!-- !langrefs -->
    </ComponentGroup>

    <DirectoryRef Id="LIBFOLDER">
      <!-- !langfiles -->
    </DirectoryRef>

  </Product>
</Wix>
